#include <string_view>

namespace hha::version {

inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";
inline constexpr std::string_view kGitSha = "@HHA_GIT_SHA@";

/// What the release files are built for: "windows-x64", "linux-x64", "linux-arm64".
constexpr std::string_view platform() {
#if defined(_WIN32)
#if defined(_M_ARM64)
    return "windows-arm64";
#else
    return "windows-x64";
#endif
#elif defined(__APPLE__)
#if defined(__aarch64__)
    return "macos-arm64";
#else
    return "macos-x64";
#endif
#else
#if defined(__aarch64__)
    return "linux-arm64";
#elif defined(__arm__)
    return "linux-armv7";
#else
    return "linux-x64";
#endif
#endif
}

}  // namespace hha::version
