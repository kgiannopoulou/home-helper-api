# Production settings: copy to the server's .env and fill in every blank.
# Nothing here is a working secret. `php artisan app:production-check` fails
# the deploy if a value is still unsafe (docs/deployment.md).
# .env.example is for local development only: its Sail password, debug mode
# and demo logins must never reach a server.

APP_NAME="Home Helper"
APP_ENV=production
APP_KEY=                                # php artisan key:generate --show, once; keep it (it decrypts sessions and 2FA secrets)
APP_DEBUG=false
APP_URL=https://home.example.com        # https: invite links and cookies depend on it
APP_VERSION=                            # set by the deploy, e.g. the git tag; shown on /system/health

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# JSON lines in storage/logs/laravel.json-*.log, for a log shipper; use stderr in containers
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLOW_QUERY_MS=500

# A user with rights on this database only (not root). The backup restore
# test also needs CREATE/DROP on BACKUP_RESTORE_DATABASE.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=home_helper
DB_USERNAME=home_helper
DB_PASSWORD=                            # long and random

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_MAX_WAITING=100
CACHE_STORE=redis

REDIS_CLIENT=phpredis                   # or predis without the extension
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Phone tokens expire after 90 days (minutes)
SANCTUM_TOKEN_EXPIRATION=129600
# Browser origins allowed to call the API (the phone app doesn't need one)
CORS_ALLOWED_ORIGINS=https://home.example.com
# The load balancer or reverse proxy in front, if any
TRUSTED_PROXIES=

HOME_TIMEZONE=Europe/Athens
EXPO_ACCESS_TOKEN=

# Who may open /system/health, and where alerts go
OPS_ADMIN_EMAILS=
OPS_ALERT_EMAIL=
OPS_ALERT_COOLDOWN_MINUTES=15

# Off-server backups: an s3 disk (config/filesystems.php) with these. It needs
# `composer require league/flysystem-aws-s3-v3` (any S3-compatible store works)
BACKUP_DISK=s3
BACKUP_PATH=backups
BACKUP_KEEP=14
BACKUP_MAX_AGE_HOURS=26
BACKUP_RESTORE_DATABASE=home_helper_restore_test
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
