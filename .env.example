APP_NAME="Home Helper"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=home_helper_api
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 5: the household day (when the scheduled jobs run) and Expo push
HOME_TIMEZONE=Europe/Athens
EXPO_ACCESS_TOKEN=

# Running it (docs/operations.md). Locally the demo owner may open /system/health.
OPS_ADMIN_EMAILS=demo@homehelper.test
OPS_ALERT_EMAIL=
LOG_SLOW_QUERY_MS=500
SANCTUM_TOKEN_EXPIRATION=129600
CORS_ALLOWED_ORIGINS=*
TRUSTED_PROXIES=
QUEUE_MAX_WAITING=100
# Backups (docs/backups.md): mysqldump/mysql must be on the PATH, or set their paths
BACKUP_DISK=local
BACKUP_KEEP=14
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

# The assistant (docs/assistant.md). claude needs ANTHROPIC_API_KEY;
# offline answers the common questions without a model or a key.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_ALLOW_WRITES=true
AI_DAILY_MESSAGES=200

# Memory (docs/memory.md). local embeds in PHP with no key; voyage uses Voyage AI
# (VOYAGE_API_KEY). After changing it: php artisan memory:reindex
MEMORY_EMBEDDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Voice (docs/voice.md). browser: the browser does speech (no service);
# service: the local voice service (docker compose --profile voice up -d voice)
VOICE_DRIVER=browser
VOICE_SERVICE_URL=http://voice:8090
VOICE_SERVICE_TOKEN=
VOICE_WAKE_URL=ws://localhost:8090/v1/wake

# The morning briefing, at home time (docs/briefings.md)
BRIEFING_TIME=07:00
